# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/newbranch
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT
JWT_SECRET_KEY=your-super-secret-key-at-least-256-bits-long-for-production-use-only-change-this
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_ISSUER=newbranch

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail (Gmail 앱 비밀번호 발급 필요)
# 발급 방법: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# Email Verification
EMAIL_VERIFICATION_EXPIRATION=86400000
EMAIL_VERIFICATION_BASE_URL=http://localhost:8080
EMAIL_FROM=noreply@newbranch.com

# OAuth2 (Google Cloud Console에서 발급)
# 발급 방법: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
# 로컬: http://localhost:3000/oauth2/redirect | 배포: https://your-domain.com/oauth2/redirect
OAUTH2_REDIRECT_URL=http://localhost:3000/oauth2/redirect

# [AWS 인증 정보]
# AWS Access Key ID: IAM 사용자의 액세스 키를 입력하세요.
AWS_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_ID

# AWS Secret Access Key: IAM 사용자의 비밀 액세스 키를 입력하세요. (외부 노출 주의)
AWS_SECRET_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# [S3 버킷 설정]
# AWS_S3_BUCKET: S3에서 생성한 버킷 이름을 입력하세요.
AWS_S3_BUCKET=your-unique-bucket-name

# AWS_REGION: 버킷이 위치한 리전을 입력하세요. (서울: ap-northeast-2)
AWS_REGION=ap-northeast-2